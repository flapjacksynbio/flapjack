# Template for production environment variables.
#
# Copy to .env.prod on the server and fill in real values. Never commit the
# filled-in file: it holds live credentials.
#
# Generate a fresh secret key, do not reuse any value that has been in version
# control:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=flapjack_api.settings_prod

# Comma separated, no scheme. Example: flapjack.example.org,www.flapjack.example.org
DJANGO_ALLOWED_HOSTS=

# Comma separated, with scheme. Example: https://flapjack.example.org
DJANGO_CORS_ALLOWED_ORIGINS=

# Set to 0 only if TLS is terminated somewhere that already forces HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1

SQL_DATABASE=registry
SQL_USER=
SQL_PASSWORD=
SQL_HOST=db
SQL_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Advertised by GET /api/info/. Include the trailing /api/ and /ws/.
FLAPJACK_PUBLIC_HTTP_API=
FLAPJACK_PUBLIC_WS_API=
FLAPJACK_API_VERSION=1.0.0
